# Keep the build context small and keep local state out of the image.
#
# .env is listed first and deliberately: the key is supplied to the container as an
# environment variable by the host, never baked into a layer. An image is copyable, and
# a secret in a layer survives being deleted in a later one.
.env
.env.*
!.env.example

.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local databases and anything derived from a real run. A fresh deploy seeds its own.
data/*.db
data/*.db-*

.git/
.github/
.claude/

# Node's build inputs are not needed: frontend/dist is committed and is what gets served.
# Named one by one rather than with wildcards, and the built output is then explicitly
# un-ignored. Docker's `*` does not cross a `/`, so `frontend/*.html` would not in fact
# reach frontend/dist/index.html — but a deployment that serves a blank page because of
# a disagreement about glob semantics is not a thing to risk, and `!` says it outright.
frontend/node_modules/
frontend/src/
frontend/.claude/
frontend/index.html
frontend/package.json
frontend/package-lock.json
frontend/tsconfig.json
frontend/tsconfig.tsbuildinfo
frontend/vite.config.ts
frontend/tailwind.config.js
frontend/postcss.config.js

# The front end KRYteria actually serves. Never exclude this.
!frontend/dist

# Development-only material.
tests/
output/demo_runs/
output/screenshots/
*.zip
