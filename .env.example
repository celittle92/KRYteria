# KRYteria — copy to .env and fill in. Never commit the real .env.
#
# KRYteria looks for a .env file in this folder first, then in each folder above it, then
# in the process environment. The teaching staff keep one shared .env one level above the
# cloned repo; that case is supported and tested.

# The course key. This is the only key KRYteria needs.
PORTKEY_API_KEY=

# Optional. The model is pinned to gpt-6-luna in app_config.py and this cannot override it;
# a different value is ignored and reported rather than honoured.
OPENAI_MODEL=gpt-6-luna

# Optional Portkey routing, only if your gateway needs them.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=
# PORTKEY_CONFIG_ID=

# Signs the session cookie. Leave blank locally and one is generated per start;
# set a fixed value in a hosted deployment so sessions survive a restart.
KRYTERIA_SECRET_KEY=

# Daily spend guards for a hosted deployment. Enforced in code by the orchestrator.
KRYTERIA_DAILY_TOKENS_PER_ACCOUNT=120000
KRYTERIA_DAILY_TOKENS_GLOBAL=2000000
